# Node Environment
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/routeflow

# JWT Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# CORS & Client
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080

# Logging & Monitoring
LOG_LEVEL=info
PROMETHEUS_METRICS_ENABLED=true

# Bootstrap Admin Credentials (used during initial seed script)
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@routeflow.io
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
BOOTSTRAP_ADMIN_PHONE=+1-555-0199


# Local academic demos only: set true to allow driver/logistics self-registration.
# Default false; keep false in production. Administrator signup is always blocked.
ALLOW_PUBLIC_STAFF_SIGNUP=false

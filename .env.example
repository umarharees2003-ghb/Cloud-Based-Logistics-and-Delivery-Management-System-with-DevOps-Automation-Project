JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://frontend:8080
GRAFANA_ADMIN_USER=routeflow-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
# Host port only; containers always use backend:5000
BACKEND_PORT=5001

# Local academic demos only: set true to allow driver/logistics self-registration.
# Default false; keep false in production. Administrator signup is always blocked.
ALLOW_PUBLIC_STAFF_SIGNUP=false

# Deployment environment: only development permits public staff demo signup.
APP_ENV=production
